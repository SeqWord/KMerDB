     misc_feature    1434876..1435535
                     /gene="pyrF"
                     /locus_tag="KPN_01277"
                     /note="Orotidine 5&apos;-phosphate decarboxylase (ODCase)
                     is a dimeric enzyme that decarboxylates orotidine
                     5&apos;-monophosphate (OMP) to form uridine
